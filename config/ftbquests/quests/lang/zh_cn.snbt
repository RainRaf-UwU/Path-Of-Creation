	quest.2BC011A259CB912A.quest_desc: ["从飞龙合成注入器和原子锻造开始，逐步推进到命令方块。"]
	quest.2BC011A259CB912A.title: "踏上创世之径"
	quest.2D79E9DFA050F756.quest_desc: ["&a量子计算机多方块结构最大大小从7x7x7改为10x10x10"]
	quest.3043320DAB93BBA8.quest_desc: ["你要是铁多到用不完那就做这个"]
